diff --git a/crates/victory-gpu/src/host/constructor_bridge.rs b/crates/victory-gpu/src/host/constructor_bridge.rs
new file mode 100644
index 0000000000000000000000000000000000000000..94f940e0c6a20657ce5cb6948a7280f5e9bdb72e
--- /dev/null
+++ b/crates/victory-gpu/src/host/constructor_bridge.rs
@@ -0,0 +1,131 @@
+//! An ordered gather and scatter adapter for the standalone ConstructBVH4
+//! fixture. All eight root spans must already name proven backing.
+use super::constructor_layout::{self as layout, Binding, Need, ROOTS, TABLE_BYTES};
+use super::*;
+
+pub(super) struct Owner<'a> {
+    pub resource: &'a ID3D12Resource,
+    pub entry: D3D12_RESOURCE_STATES,
+}
+pub(super) struct Arena {
+    pub plan: layout::Layout,
+    pub data: *const u8,
+}
+
+fn state(
+    list: &HostList,
+    buffer: &ID3D12Resource,
+    from: D3D12_RESOURCE_STATES,
+    to: D3D12_RESOURCE_STATES,
+) {
+    if from != to {
+        unsafe {
+            list.list.ResourceBarrier(&[transition(buffer, from, to)]);
+        }
+    }
+}
+
+pub(super) fn record(
+    host: &Host,
+    list: &HostList,
+    root: &ID3D12RootSignature,
+    pso: &ID3D12PipelineState,
+    table: &[u8; TABLE_BYTES],
+    bindings: &[Option<Binding>; ROOTS],
+    needs: &[Need; ROOTS],
+    owners: &[Owner],
+    io: &ID3D12Resource,
+    result_regs: &ID3D12Resource,
+    unused_win: &ID3D12Resource,
+) -> Result<Arena, &'static str> {
+    let mut ids = std::collections::BTreeSet::new();
+    let widths: Vec<_> = owners
+        .iter()
+        .map(|o| {
+            if !ids.insert(o.resource.as_raw() as usize) {
+                return Err("duplicate resource identity");
+            }
+            let desc = unsafe { o.resource.GetDesc() };
+            if desc.Dimension != D3D12_RESOURCE_DIMENSION_BUFFER {
+                return Err("owner is not a buffer");
+            }
+            Ok(desc.Width)
+        })
+        .collect::<Result<_, _>>()?;
+    let plan = layout::make(table, bindings, needs, &widths)?;
+    // Every validation and allocation completes before recording commands.
+    let (arena, p) = host
+        .shared_buffer(plan.arena_bytes)
+        .ok_or("cannot allocate packed window")?;
+    let (arg_upload, up) = host
+        .upload_buffer(TABLE_BYTES as u64)
+        .ok_or("cannot allocate root argument upload")?;
+    unsafe {
+        p.write_bytes(0xa5, plan.arena_bytes as usize);
+        std::ptr::copy_nonoverlapping(plan.table.as_ptr(), up, TABLE_BYTES);
+    }
+    for b in [&arena, &arg_upload, io, result_regs, unused_win] {
+        list.keep(b);
+    }
+    list.keep(root);
+    list.keep(pso);
+    let read: D3D12_RESOURCE_STATES = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    let write = D3D12_RESOURCE_STATE_COPY_DEST;
+    let uav = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+    let common = D3D12_RESOURCE_STATE_COMMON;
+    let used: std::collections::BTreeSet<_> = plan.gather.iter().map(|c| c.owner).collect();
+    let modified: std::collections::BTreeSet<_> = plan.scatter.iter().map(|c| c.owner).collect();
+    for &i in &used {
+        list.keep(owners[i].resource);
+        state(list, owners[i].resource, owners[i].entry, read);
+    }
+    state(list, &arena, common, write);
+    unsafe {
+        list.list
+            .CopyBufferRegion(&arena, 0, &arg_upload, 0, TABLE_BYTES as u64);
+        for c in &plan.gather {
+            list.list.CopyBufferRegion(
+                &arena,
+                c.arena,
+                owners[c.owner].resource,
+                c.offset,
+                c.bytes,
+            );
+        }
+    }
+    state(list, &arena, write, uav);
+    unsafe {
+        list.list.SetComputeRootSignature(root);
+        list.list.SetPipelineState(pso);
+        for (k, r) in [io, result_regs, &arena, unused_win, unused_win, unused_win]
+            .iter()
+            .enumerate()
+        {
+            list.list
+                .SetComputeRootUnorderedAccessView(k as u32, r.GetGPUVirtualAddress());
+        }
+        list.list.Dispatch(1, 1, 1);
+    }
+    // Transition from UAV both orders previous writes and permits the actual GPU copy.
+    state(list, &arena, uav, read);
+    for &i in &modified {
+        state(list, owners[i].resource, read, write);
+    }
+    unsafe {
+        for c in &plan.scatter {
+            list.list.CopyBufferRegion(
+                owners[c.owner].resource,
+                c.offset,
+                &arena,
+                c.arena,
+                c.bytes,
+            );
+        }
+    }
+    for &i in &used {
+        let from = if modified.contains(&i) { write } else { read };
+        state(list, owners[i].resource, from, owners[i].entry);
+    }
+    state(list, &arena, read, common);
+    Ok(Arena { plan, data: p })
+}
diff --git a/crates/victory-gpu/src/host/constructor_bridge_test.rs b/crates/victory-gpu/src/host/constructor_bridge_test.rs
new file mode 100644
index 0000000000000000000000000000000000000000..293439bc382e1c1df014ade55c1f5cc8863b4248
--- /dev/null
+++ b/crates/victory-gpu/src/host/constructor_bridge_test.rs
@@ -0,0 +1,252 @@
+use super::*;
+use crate::host::constructor_bridge::{Owner, record};
+use crate::host::constructor_layout::{Binding, Need, TABLE_BYTES};
+
+// Seven actual allocations for eight root addresses: root 4 is a bounded
+// subspan of root 0. Synthetic guest VAs deliberately are not host GPU VAs.
+const OWNER_ID: [usize; 8] = [0, 1, 2, 3, 0, 4, 5, 6];
+const BASES: [u64; 7] = [
+    0x190001000,
+    0x200006000,
+    0x780001000,
+    0x1400002000,
+    0x1a40002000,
+    0x970009000,
+    0x480004000,
+];
+const PREFIX_WORDS: [usize; 7] = [13, 21, 19, 9, 37, 17, 29];
+const SUFFIX_WORDS: usize = 21;
+
+pub(super) fn verify(host: &Host, root: &ID3D12RootSignature, split: bool) {
+    let pso = create_pipeline(
+        host,
+        root,
+        &format!("Z:\\fixture\\constructor\\windows4-split{split}.dxil"),
+    );
+    for (count, initial) in [(2usize, 0usize), (1, 1), (2, 2), (3, 3)] {
+        let name = format!("instances-{count}-initial-{initial}");
+        let file = format!("Z:\\fixture\\constructor\\cases\\{name}");
+        let source = fixture_words(&format!("{file}.input"));
+        let expected = fixture_words(&format!("{file}.expected"));
+        let leaf_base = (count - 1).max(1);
+        let nodes = leaf_base + count;
+        let bytes = [
+            128 + 128 * count + 128 * leaf_base,
+            4 * nodes,
+            4 * nodes,
+            8 * nodes,
+            64,
+            4,
+            24 * nodes,
+            4 * count,
+        ];
+        let mut table = [0u8; TABLE_BYTES];
+        for (i, v) in source[..20].iter().enumerate() {
+            table[4 * i..4 * i + 4].copy_from_slice(&v.to_le_bytes());
+        }
+        let original: [usize; 8] = std::array::from_fn(|i| {
+            u64::from_le_bytes(table[i * 8..i * 8 + 8].try_into().unwrap()) as usize
+        });
+        assert_eq!(original[4] - original[0], 64);
+        let mut buffers = Vec::new();
+        let mut expect_owners = Vec::new();
+        let mut proofs = [None; 8];
+        let needs = std::array::from_fn(|i| Need {
+            bytes: bytes[i] as u64,
+            writable: i != 7,
+        });
+        for i in 0..8 {
+            let owner = OWNER_ID[i];
+            let base = BASES[owner];
+            let guest = base + if i == 4 { 64 } else { 0 };
+            table[i * 8..i * 8 + 8].copy_from_slice(&guest.to_le_bytes());
+            let offset = PREFIX_WORDS[owner] * 4;
+            let available = if i == 4 { bytes[0] } else { bytes[i] };
+            proofs[i] = Some(Binding {
+                owner,
+                guest_base: base,
+                owner_offset: offset as u64,
+                available: available as u64,
+            });
+            if i == 4 {
+                continue;
+            }
+            assert_eq!(owner, buffers.len());
+            let mut contents = vec![SENTINEL; PREFIX_WORDS[owner] + bytes[i] / 4 + SUFFIX_WORDS];
+            let segment = PREFIX_WORDS[owner]..PREFIX_WORDS[owner] + bytes[i] / 4;
+            let orig = original[i] / 4..(original[i] + bytes[i]) / 4;
+            contents[segment.clone()].copy_from_slice(&source[orig.clone()]);
+            let mut want = contents.clone();
+            want[segment].copy_from_slice(&expected[orig]);
+            // The preceding GPU command supplies the true element count.
+            if i == 0 {
+                contents[PREFIX_WORDS[0] + 3] = if initial == 0 { 1 } else { 0 };
+            }
+            buffers.push(Shared::new(host, &contents));
+            expect_owners.push(want);
+        }
+        let mut sgprs = [0; 128];
+        sgprs[0] = 0;
+        sgprs[1] = 0;
+        sgprs[112] = 0;
+        let io = Shared::new(host, &sgprs);
+        let result_regs = Shared::new(host, &[0; 128]);
+        let unused_win = Shared::new(host, &[SENTINEL; 256]);
+        let output_bytes = bytes[0];
+        let (after, read) = host.shared_buffer(output_bytes as u64).unwrap();
+        let (patch, p) = host.upload_buffer(4).unwrap();
+        unsafe {
+            p.cast::<u32>().write(source[original[0] / 4 + 3]);
+        }
+        let owners: Vec<_> = buffers
+            .iter()
+            .enumerate()
+            .map(|(i, b)| Owner {
+                resource: &b.resource,
+                entry: if i == 0 {
+                    D3D12_RESOURCE_STATE_COPY_DEST
+                } else {
+                    D3D12_RESOURCE_STATE_COMMON
+                },
+            })
+            .collect();
+        let list = host.new_list().unwrap();
+        unsafe {
+            list.list.ResourceBarrier(&[transition(
+                &buffers[0].resource,
+                D3D12_RESOURCE_STATE_COMMON,
+                D3D12_RESOURCE_STATE_COPY_DEST,
+            )]);
+            list.list.CopyBufferRegion(
+                &buffers[0].resource,
+                (PREFIX_WORDS[0] * 4 + 12) as u64,
+                &patch,
+                0,
+                4,
+            );
+        }
+        // Verify invalid requests emit no commands and leave the list usable.
+        let mut missing = proofs;
+        missing[6] = None;
+        assert!(
+            record(
+                host,
+                &list,
+                root,
+                &pso,
+                &table,
+                &missing,
+                &needs,
+                &owners,
+                &io.resource,
+                &result_regs.resource,
+                &unused_win.resource
+            )
+            .is_err()
+        );
+        let mut small = proofs;
+        small[4].as_mut().unwrap().available = 68;
+        assert!(
+            record(
+                host,
+                &list,
+                root,
+                &pso,
+                &table,
+                &small,
+                &needs,
+                &owners,
+                &io.resource,
+                &result_regs.resource,
+                &unused_win.resource
+            )
+            .is_err()
+        );
+        let packed = record(
+            host,
+            &list,
+            root,
+            &pso,
+            &table,
+            &proofs,
+            &needs,
+            &owners,
+            &io.resource,
+            &result_regs.resource,
+            &unused_win.resource,
+        )
+        .unwrap();
+        assert_eq!(packed.plan.gather.len(), 7);
+        assert_eq!(packed.plan.scatter.len(), 6);
+        assert_eq!(packed.plan.table[64..], table[64..]);
+        unsafe {
+            list.list.ResourceBarrier(&[
+                transition(
+                    &buffers[0].resource,
+                    D3D12_RESOURCE_STATE_COPY_DEST,
+                    D3D12_RESOURCE_STATE_COPY_SOURCE,
+                ),
+                transition(
+                    &after,
+                    D3D12_RESOURCE_STATE_COMMON,
+                    D3D12_RESOURCE_STATE_COPY_DEST,
+                ),
+            ]);
+            list.list.CopyBufferRegion(
+                &after,
+                0,
+                &buffers[0].resource,
+                (PREFIX_WORDS[0] * 4) as u64,
+                output_bytes as u64,
+            );
+            list.list.ResourceBarrier(&[
+                transition(
+                    &after,
+                    D3D12_RESOURCE_STATE_COPY_DEST,
+                    D3D12_RESOURCE_STATE_COMMON,
+                ),
+                transition(
+                    &buffers[0].resource,
+                    D3D12_RESOURCE_STATE_COPY_SOURCE,
+                    D3D12_RESOURCE_STATE_COMMON,
+                ),
+            ]);
+        }
+        list.close();
+        host.execute(&[&list]);
+        assert!(unsafe { host.device.GetDeviceRemovedReason() }.is_ok());
+        for (i, (buf, want)) in buffers.iter().zip(&expect_owners).enumerate() {
+            if let Some(k) = buf.read().iter().zip(want).position(|(a, b)| a != b) {
+                panic!(
+                    "{name}: backing {i} at byte {:#x} got {:#x}, expected {:#x}",
+                    k * 4,
+                    buf.read()[k],
+                    want[k]
+                );
+            }
+        }
+        assert_eq!(
+            unsafe { std::slice::from_raw_parts(read.cast::<u32>(), output_bytes / 4) },
+            &expect_owners[0][PREFIX_WORDS[0]..PREFIX_WORDS[0] + output_bytes / 4]
+        );
+        assert!(unused_win.read().iter().all(|&v| v == SENTINEL));
+        // Every unallocated byte in the packed window is a guard, including
+        // the area around the argument table.
+        let arena =
+            unsafe { std::slice::from_raw_parts(packed.data, packed.plan.arena_bytes as usize) };
+        assert_eq!(&arena[..TABLE_BYTES], &packed.plan.table);
+        for (at, &value) in arena.iter().enumerate().skip(TABLE_BYTES) {
+            if !packed
+                .plan
+                .gather
+                .iter()
+                .any(|x| (x.arena..x.arena + x.bytes).contains(&(at as u64)))
+            {
+                assert_eq!(value, 0xa5, "arena guard {at:#x}");
+            }
+        }
+        println!(
+            "{name}: eight roots on seven resource subspans, six scatter spans, earlier count write and later result copy matched, original constants and every owner/arena guard preserved"
+        );
+    }
+}
diff --git a/crates/victory-gpu/src/host/constructor_layout.rs b/crates/victory-gpu/src/host/constructor_layout.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c3373d5dc10584ea1485666415380ff748b32d6a
--- /dev/null
+++ b/crates/victory-gpu/src/host/constructor_layout.rs
@@ -0,0 +1,181 @@
+//! Validate all eight typed root-buffer witnesses before building a compact
+//! window for this constructor command. The following 16 argument bytes are
+//! the original root constants. Only the eight pointer fields are relocated.
+pub(super) const ROOTS: usize = 8;
+pub(super) const TABLE_BYTES: usize = 80;
+
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Binding {
+    pub owner: usize,
+    pub guest_base: u64,
+    pub owner_offset: u64,
+    pub available: u64,
+}
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Need {
+    pub bytes: u64,
+    pub writable: bool,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) struct Transfer {
+    pub owner: usize,
+    pub offset: u64,
+    pub arena: u64,
+    pub bytes: u64,
+}
+
+pub(super) struct Layout {
+    pub table: [u8; TABLE_BYTES],
+    pub gather: Vec<Transfer>,
+    pub scatter: Vec<Transfer>,
+    pub arena_bytes: u64,
+}
+
+#[derive(Clone, Copy)]
+struct Range {
+    owner: usize,
+    guest: u64,
+    offset: u64,
+    bytes: u64,
+    writable: bool,
+}
+
+fn overlap(a: u64, end_a: u64, b: u64, end_b: u64) -> bool {
+    a < end_b && b < end_a
+}
+fn combine(inputs: &mut Vec<Transfer>) {
+    inputs.sort_unstable_by_key(|r| (r.owner, r.offset));
+    let mut joined: Vec<Transfer> = Vec::new();
+    for r in inputs.iter().copied() {
+        if let Some(last) = joined.last_mut()
+            && last.owner == r.owner
+            && r.offset <= last.offset + last.bytes
+        {
+            last.bytes = (last.offset + last.bytes).max(r.offset + r.bytes) - last.offset;
+        } else {
+            joined.push(r);
+        }
+    }
+    *inputs = joined;
+}
+
+pub(super) fn make(
+    table: &[u8; TABLE_BYTES],
+    bindings: &[Option<Binding>; ROOTS],
+    needs: &[Need; ROOTS],
+    owner_widths: &[u64],
+) -> Result<Layout, &'static str> {
+    let mut roots = Vec::with_capacity(ROOTS);
+    for (i, (proof, need)) in bindings.iter().zip(needs).enumerate() {
+        let b = proof.ok_or("missing root ownership")?;
+        let width = *owner_widths
+            .get(b.owner)
+            .ok_or("missing backing resource")?;
+        let guest = u64::from_le_bytes(table[i * 8..i * 8 + 8].try_into().unwrap());
+        if guest == 0
+            || guest % 4 != 0
+            || b.owner_offset % 4 != 0
+            || need.bytes == 0
+            || need.bytes % 4 != 0
+        {
+            return Err("empty or unaligned root interval");
+        }
+        let guest_end = b
+            .guest_base
+            .checked_add(b.available)
+            .ok_or("guest interval overflow")?;
+        let root_end = guest
+            .checked_add(need.bytes)
+            .ok_or("root interval overflow")?;
+        if guest < b.guest_base || root_end > guest_end {
+            return Err("root exceeds its proven interval");
+        }
+        if b.owner_offset
+            .checked_add(b.available)
+            .is_none_or(|end| end > width)
+        {
+            return Err("backing interval exceeds resource");
+        }
+        let offset = b.owner_offset + (guest - b.guest_base);
+        if offset % 4 != 0 {
+            return Err("unaligned host offset");
+        }
+        roots.push(Range {
+            owner: b.owner,
+            guest,
+            offset,
+            bytes: need.bytes,
+            writable: need.writable,
+        });
+    }
+    for (i, a) in roots.iter().enumerate() {
+        for b in &roots[..i] {
+            let guest_overlap = overlap(a.guest, a.guest + a.bytes, b.guest, b.guest + b.bytes);
+            let same_owner = a.owner == b.owner;
+            let host_overlap =
+                same_owner && overlap(a.offset, a.offset + a.bytes, b.offset, b.offset + b.bytes);
+            let same_translation = same_owner
+                && i128::from(a.guest) - i128::from(a.offset)
+                    == i128::from(b.guest) - i128::from(b.offset);
+            if (guest_overlap || host_overlap) && !same_translation {
+                return Err("inconsistent alias mapping");
+            }
+        }
+    }
+    let mut gather: Vec<_> = roots
+        .iter()
+        .map(|r| Transfer {
+            owner: r.owner,
+            offset: r.offset,
+            arena: 0,
+            bytes: r.bytes,
+        })
+        .collect();
+    combine(&mut gather);
+    let mut cursor = 256u64; // root table and an untouched guard come first.
+    for c in &mut gather {
+        c.arena = cursor
+            .checked_next_multiple_of(256)
+            .ok_or("arena alignment overflow")?;
+        cursor = c
+            .arena
+            .checked_add(c.bytes)
+            .and_then(|x| x.checked_add(64))
+            .ok_or("arena length overflow")?;
+        if cursor > u32::MAX as u64 {
+            return Err("arena is outside the single 32-bit window");
+        }
+    }
+    let packed = |r: &Range| {
+        gather
+            .iter()
+            .find(|c| {
+                c.owner == r.owner
+                    && r.offset >= c.offset
+                    && r.offset + r.bytes <= c.offset + c.bytes
+            })
+            .map(|c| c.arena + (r.offset - c.offset))
+            .ok_or("unmapped packed range")
+    };
+    let mut table = *table;
+    let mut scatter = Vec::new();
+    for (i, r) in roots.iter().enumerate() {
+        let arena = packed(r)?;
+        table[i * 8..i * 8 + 8].copy_from_slice(&arena.to_le_bytes());
+        if r.writable {
+            scatter.push(Transfer {
+                owner: r.owner,
+                offset: r.offset,
+                arena,
+                bytes: r.bytes,
+            });
+        }
+    }
+    combine(&mut scatter); // all overlapping/adjacent writes are inside the same gather chunk.
+    Ok(Layout {
+        table,
+        gather,
+        scatter,
+        arena_bytes: cursor,
+    })
+}
diff --git a/crates/victory-gpu/src/host/xcl_header_test.rs b/crates/victory-gpu/src/host/xcl_header_test.rs
